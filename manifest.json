{
  "manifest_version": 3,
  "name": "Ultimate Ad Blocker",
  "version": "1.0",
  "description": "Blocks ads completely, including YouTube popups, with customizable intensity.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page_context.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_light",
        "enabled": true,
        "path": "rules_light.json"
      },
      {
        "id": "ruleset_severe",
        "enabled": false,
        "path": "rules_severe.json"
      }
    ]
  }
}
